# Variáveis lidas pelo docker-compose.yml. Copie para .env e ajuste se precisar.
# Todas têm default no compose — este arquivo só existe pra facilitar sobrescrever.

# uid/gid do seu usuário no host (rode `id -u` / `id -g`), pra que os arquivos
# criados dentro do container (vendor/, .env, logs) não fiquem como root.
APP_UID=1000
APP_GID=1000

API_PORT=8000

# Onde ficam os repos dos projetos que o painel vai gerenciar.
# Montado no MESMO caminho dentro do container.
PROJECTS_DIR=/home/dev/projetos

# Precisa bater com o AISF_API_TOKEN do mcp-server/.env.
MCP_API_TOKEN=local-dev-token

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@teamdevs.local
ADMIN_PASSWORD=password
